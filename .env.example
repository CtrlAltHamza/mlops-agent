# Copy to .env and fill in. Never commit .env or real credentials.

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=churn-training

AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_APPROVED_DAGS=ml_training_pipeline

APPROVED_K8S_NAMESPACE=mlops-inference
KUBECONFIG=

# Optional. Without these, graded scenarios still run through the deterministic tool planner.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_PLANNER=false

QUALITY_GATE_THRESHOLD=0.60
APP_VERSION=1.0.0
MODEL_PATH=models/model.joblib
